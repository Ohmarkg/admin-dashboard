# =============================================================================
# Env templates for TAMU SHPE Admin Web
# =============================================================================
# Copy the block you need into the right file. Never commit real secrets.
#
#   Emulator (host)     → .env.development is already committed with this shape.
#                         Docker Compose injects its own emulator hosts for `web`.
#   Production-local    → copy into .env.local (gitignored) and fill secrets.
#
# Next.js merges env files. Omitting a key in .env.local does NOT clear it if
# .env.development still sets it — production-local MUST blank the emulator
# host vars explicitly (see below).
# =============================================================================

# -----------------------------------------------------------------------------
# Emulator (host) — no secrets; Auth emulator ignores the API key
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_API_KEY=dummy-emulator-key
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# -----------------------------------------------------------------------------
# Production-local (.env.local) — points bun run dev at real tamushpemobileapp
# -----------------------------------------------------------------------------
# Sources (Firebase Console → project tamushpemobileapp):
#   NEXT_PUBLIC_GOOGLE_API_KEY     → Project settings → Your apps → Web API key
#   FIREBASE_SERVICE_ACCOUNT_KEY   → Project settings → Service accounts
#                                    → Generate new private key → stringify to ONE line
#                                    (keep \n escapes inside private_key)
#
# Leave emulator hosts empty so .env.development values are overridden.
# Do NOT use docker compose for this mode — stop it first.
#
# NEXT_PUBLIC_GOOGLE_API_KEY=replace-with-web-api-key
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# FIRESTORE_EMULATOR_HOST=
# FIREBASE_AUTH_EMULATOR_HOST=
# FIREBASE_STORAGE_EMULATOR_HOST=
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"tamushpemobileapp",...}
#
# Optional — defaults to us-central1 callables on this project:
# CLOUD_FUNCTIONS_ORIGIN=https://us-central1-tamushpemobileapp.cloudfunctions.net
